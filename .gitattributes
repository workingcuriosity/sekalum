# ==========================================
# Sekalum
# ==========================================

# Standard: Textdateien automatisch normalisieren
* text=auto eol=lf

# Source Code
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.env.example text eol=lf

# Windows-Skripte
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Docker
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Binary files
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.tgz     binary
*.tar     binary
