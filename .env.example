# Development-only key. Replace it with a unique secret before any non-local deployment.
# It is exactly 32 characters and must never protect production data.
TOKEN_ENCRYPTION_KEY=DEV_ONLY_NOT_FOR_PRODUCTION_0000

# Optional runtime configuration
OAUTH_CALLBACK_PORT=3000
BASE_PATH=/
# PUBLIC_BASE_URL=https://sekalum.example.com
CHECK_INTERVAL_HOURS=12
CONNECTION_TEST_ALLOW_PRIVATE_NETWORKS=false
# CUSTOM_PROVIDER_DEFINITIONS=[]

# Alternative key rotation configuration (use instead of TOKEN_ENCRYPTION_KEY).
# TOKEN_ENCRYPTION_KEYS={"1":"REPLACE_WITH_A_32_CHARACTER_SECRET"}
# TOKEN_ENCRYPTION_KEY_VERSION=1
